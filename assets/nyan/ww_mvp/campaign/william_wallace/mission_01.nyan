# NYAN FILE
!version 0.2.0
# =============================================================================
# HAND-WRITTEN MVP FIXTURE - NOT A CONVERTER PRODUCT.
# Source of truth: assets/nyan/ww_mvp/campaign/william_wallace/mission_01.nyan
# Installed to:      assets/converted/ww_mvp/campaign/william_wallace/mission_01.nyan   (by install.sh)
# Hand-authored William Wallace Mission 1 MVP scenario + player setup. NOT
# generated by the DE2 converter or `convert-export-api` (api_export). See
# assets/nyan/ww_mvp/README.md for the install/reproducibility flow.
# =============================================================================


import de2_base.data.game_entity.generic.villager.villager as de2_villager
import de2_base.data.game_entity.generic.town_center.town_center as de2_town_center
import engine.modifier
import engine.util.game_entity
import engine.util.language
import engine.util.language.translated.type
import engine.util.resource
import engine.util.scenario
import engine.util.setup
import engine.util.terrain
import engine.test.testscene_data

import engine.root as root

# ---------------------------------------------------------------------------
# Mission 1 scenario - minimal map for the campaign tutorial.
#
# Terrain tiles reference `engine.test.testscene_data.TestsceneGrass` (engine
# modpack); the player setup (PlayerSetup) lives in this same file. The
# PlacedEntity targets reference real de2_base game entities. The schema
# (Scenario / TerrainChunkLayout / PlacedEntity) stays the same.
#
# Layout (all coordinates are tile coords, top-left = (0,0)):
#
#     0     7 8     15
#   0 +-----+-+-----+
#     | G  G | G  G |
#   7 +-----+-+-----+
#   8 | G V T| E G  |
#     +-----+-+-----+
#  15 +-----+-+-----+
#     | E G  | G  E |
#     +-----+-+-----+
#
#   G = grass tile          V = player villager
#   T = town center         E = scripted enemy villager
#
# Map is 16x16 tiles, divided into 4 chunks of 8x8 each. All tiles are
# MissionGrass (engine.test.testscene_data.TestsceneGrass).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Player setup for Mission 1.
#
# This intentionally does NOT cross-reference the de2_base / aoe2_base
# modpack for Wood/Food/Stone/Gold. The converter that normally produces
# those Resource objects is mid-refactor, so depending on `de2_base.*` here
# would break `--scenario --no-prompts` on a fresh checkout. Instead we
# declare a single MissionWood Resource inside the engine modpack.
#
# Replace MissionWood with `de2_base.data.util.resource.types.Wood` (and
# drop the local declaration) once the converter emits the standard AoE2
# resource set on disk again.
# ---------------------------------------------------------------------------

# Minimal wood-only Resource. name is left abstract (filled in below).
MissionWood(engine.util.resource.Resource):
    Resource.name = MissionWoodName
    Resource.max_storage = 10000

# Mission 1 starts the player with 0 wood so the gather loop is the
# whole point. Later missions may want a different starting package
# (Mission 2 wants 200 wood so the house can be built immediately);
# for now the single PlayerSetup covers all missions because they share
# a PlayerSetup. If a mission needs a different starting resources set,
# add a separate PlayerSetup and wire it via --player-setup-fqon.
MissionWoodAmount(engine.util.resource.ResourceAmount):
    ResourceAmount.type = MissionWood
    ResourceAmount.amount = 0.0

# Empty modifier set used to satisfy PlayerSetup.modifiers.
MissionEmptyModifier(engine.modifier.Modifier):
    Modifier.properties = {}

# Empty description (no in-game description text yet).
MissionEmptyDescription(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        MissionEmptyText
    }

MissionEmptyText(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = MissionLang
    LanguageTextPair.string = ""

# Translated markup-file placeholders. The schema requires TranslatedMarkupFile
# instances for description / long_description; we provide an empty markup
# set (no file references) because no markdown files exist yet.
MissionEmptyMarkup(engine.util.language.translated.type.TranslatedMarkupFile):
    TranslatedMarkupFile.translations = {}

# PlayerSetup the Mission 1 scenario uses. Fills every field declared in
# engine.util.setup.PlayerSetup (none have defaults in the schema).
PlayerSetup(engine.util.setup.PlayerSetup):
    PlayerSetup.name = MissionPlayerName
    PlayerSetup.description = MissionEmptyMarkup
    PlayerSetup.long_description = MissionEmptyMarkup
    PlayerSetup.leader_names = {}
    PlayerSetup.modifiers = {}
    PlayerSetup.starting_resources = {MissionWoodAmount}
    PlayerSetup.game_setup = o{}


# Translated name strings used above.
MissionWoodName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        MissionWoodNameEN
    }

MissionWoodNameEN(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = MissionLang
    LanguageTextPair.string = "Wood"

MissionPlayerName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        MissionPlayerNameEN
    }

MissionPlayerNameEN(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = MissionLang
    LanguageTextPair.string = "Player"

MissionLang(engine.util.language.Language):
    Language.ietf_string = "en_US"


# Size helpers used by Scenario.size and chunk offsets/sizes.
_Size16(engine.util.terrain.Size):
    Size.x = 16
    Size.y = 16

_Size8(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 8

_Size0_0(engine.util.terrain.Size):
    Size.x = 0
    Size.y = 0

_Size8_0(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 0

_Size0_8(engine.util.terrain.Size):
    Size.x = 0
    Size.y = 8

_Size8_8(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 8


# Position helpers for PlacedEntity.position.
_Pos8_8(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 8

_Pos8_9(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 9

_Pos1_1(engine.util.terrain.Size):
    Size.x = 1
    Size.y = 1

_Pos1_14(engine.util.terrain.Size):
    Size.x = 1
    Size.y = 14

_Pos14_1(engine.util.terrain.Size):
    Size.x = 14
    Size.y = 1


# ---------------------------------------------------------------------------
# PlacedEntity instances for Mission 1.
#
#   - 1 player villager at (8, 8)
#   - 1 player town center at (8, 9)
#   - 1 enemy villager at (1, 1)   (MVP combat slice: AttackCommand target)
#
# The enemy villager is the AttackCommand target for the combat vertical
# slice (approach/damage/death/victory). The legacy "gather wood" trigger
# is repurposed to defeat-enemy in a later increment.
# ---------------------------------------------------------------------------

PlayerVillager(engine.util.game_entity.PlacedEntity):
    PlacedEntity.entity = de2_base.data.game_entity.generic.villager.villager.Villager
    PlacedEntity.position = _Pos8_8

PlayerTownCenter(engine.util.game_entity.PlacedEntity):
    PlacedEntity.entity = de2_base.data.game_entity.generic.town_center.town_center.TownCenter
    PlacedEntity.position = _Pos8_9

EnemyVillager(engine.util.game_entity.PlacedEntity):
    PlacedEntity.entity = de2_base.data.game_entity.generic.villager.villager.Villager
    PlacedEntity.position = _Pos1_1


