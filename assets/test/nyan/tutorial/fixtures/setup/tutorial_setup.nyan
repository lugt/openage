import engine.modifier
import engine.util.language
import engine.util.language.translated.type
import engine.util.resource
import engine.util.setup
import engine.util.tutorial_data

import engine.root as root

# Self-contained tutorial PlayerSetup.
#
# This file intentionally does NOT cross-reference the de2_base / aoe2_base
# modpack for Wood/Food/Stone/Gold. The converter that normally produces
# those Resource objects is mid-refactor, so depending on `de2_base.*` here
# would break `--tutorial --no-prompts` on a fresh checkout. Instead we
# declare a single TutorialWood Resource inside the engine modpack.
#
# Replace TutorialWood with `de2_base.data.util.resource.types.Wood` (and
# drop the local declaration) once the converter emits the standard AoE2
# resource set on disk again.

# Minimal wood-only Resource. name is left abstract (filled in below).
TutorialWood(engine.util.resource.Resource):
    Resource.name = TutorialWoodName
    Resource.max_storage = 10000

# Mission 1 starts the player with 0 wood so the gather loop is the
# whole point. Later missions may want a different starting package
# (Mission 2 wants 200 wood so the house can be built immediately);
# for now the single TutorialPlayerSetup covers all missions because
# they share a PlayerSetup. If a mission needs a different starting
# resources set, add a separate PlayerSetup and wire it via
# --tutorial-player-setup-fqon.
TutorialWoodAmount(engine.util.resource.ResourceAmount):
    ResourceAmount.type = TutorialWood
    ResourceAmount.amount = 0

# Empty modifier set used to satisfy PlayerSetup.modifiers.
TutorialEmptyModifier(engine.modifier.Modifier):
    Modifier.properties = {}

# Empty description (no in-game description text yet).
TutorialEmptyDescription(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        TutorialEmptyText
    }

TutorialEmptyText(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = TutorialLang
    LanguageTextPair.string = ""

# Translated markup-file placeholders. The schema requires TranslatedMarkupFile
# instances for description / long_description; we provide an empty markup
# set (no file references) because no markdown files exist yet.
TutorialEmptyMarkup(engine.util.language.translated.type.TranslatedMarkupFile):
    TranslatedMarkupFile.translations = {}

# PlayerSetup the tutorial scenario uses. Fills every field declared in
# engine.util.setup.PlayerSetup (none have defaults in the schema).
TutorialPlayerSetup(engine.util.setup.PlayerSetup):
    PlayerSetup.name = TutorialPlayerName
    PlayerSetup.description = TutorialEmptyMarkup
    PlayerSetup.long_description = TutorialEmptyMarkup
    PlayerSetup.leader_names = {}
    PlayerSetup.modifiers = {}
    PlayerSetup.starting_resources = {TutorialWoodAmount}
    PlayerSetup.game_setup = o{}


# Translated name strings used above.
TutorialWoodName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        TutorialWoodNameEN
    }

TutorialWoodNameEN(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = TutorialLang
    LanguageTextPair.string = "Wood"

TutorialPlayerName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        TutorialPlayerNameEN
    }

TutorialPlayerNameEN(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = TutorialLang
    LanguageTextPair.string = "Tutorial Player"

TutorialLang(engine.util.language.Language):
    Language.ietf_string = "en_US"
