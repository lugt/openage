!version 0.2.0
# =============================================================================
# HAND-WRITTEN MVP FIXTURE - NOT A CONVERTER PRODUCT.
# Source of truth: assets/test/nyan/tutorial/fixtures/tutorial_data.nyan
# Installed to:      assets/converted/engine/util/tutorial_data.nyan   (by install.sh)
# Hand-authored stopgap for the Phase 0 tutorial scenario. NOT generated by the
# DE2 converter or `convert-export-api` (api_export). See
# assets/test/nyan/tutorial/README.md for the install/reproducibility flow.
# =============================================================================


# ----------------------------------------------------------------------------
# Self-contained tutorial data definitions.
#
# This file replaces de2_base/aoe2_base references for the tutorial scenario.
# The converter that normally produces GameEntity/Terrain instances from
# AoE2 .dat files is mid-refactor; until that lands, the tutorial needs its
# own minimal data so `bin/run --tutorial` can start without the full DE2
# modpack being present on disk.
#
# Everything here lives under `engine.util.tutorial_data.*` and is meant to
# be discarded once the converter regenerates the proper de2_base objects.
# Schema definitions (Terrain, GameEntity, Ability, etc.) come from the
# engine modpack and stay shared.
# ----------------------------------------------------------------------------

import engine.ability
import engine.ability.property
import engine.ability.type
import engine.modifier
import engine.modifier.property
import engine.util.game_entity
import engine.util.game_entity_type
import engine.util.graphics
import engine.util.language
import engine.util.language.translated
import engine.util.move_mode
import engine.util.path_type
import engine.util.terrain
import engine.util.terrain_type
import engine.util.variant

import engine.root as root


# -- TerrainType / PathType / MoveMode / GameEntityType (small tag types) ----

# Minimal TerrainType child used to satisfy the Terrain.types field.
TutorialTerrainType(engine.util.terrain_type.TerrainType):
    pass

# Minimal PathType child used by terrain path_costs + Move.path_type.
TutorialGroundPath(engine.util.path_type.PathType):
    pass

# Minimal MoveMode child for the villager's Move ability.
TutorialGroundMove(engine.util.move_mode.MoveMode):
    pass

# Minimal GameEntityType tag for villagers / town centers / enemies.
# All three of these are tagged as "Land" creatures for type filters.
TutorialUnitType(engine.util.game_entity_type.GameEntityType):
    pass

TutorialBuildingType(engine.util.game_entity_type.GameEntityType):
    pass


# -- TranslatedString / Language ------------------------------------------------

# A single English-language translation pair used everywhere a name
# appears. Re-using one pair keeps the file readable; production code
# should have a translations set with many pairs.
English(engine.util.language.Language):
    Language.ietf_string = "en_US"

EnglishName(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = English
    LanguageTextPair.string = "Tutorial Entity"


# -- Graphic / Sound primitives -------------------------------------------------

# TerrainGraphic references a real file in assets/test/textures/. The path is
# resolved by APITerrain::get_terrain_path via the nyan FileValue indirection.
TutorialTerrainGraphic(engine.util.graphics.Terrain):
    Terrain.sprite = "../test/textures/test_terrain.terrain"

# Sound is required by Terrain.sound; we point at a non-existent file
# because the tutorial currently doesn't play terrain ambience sounds.
# nyan's FileValue only requires a syntactically valid path string.
TutorialSound(engine.util.sound.Sound):
    Sound.play_delay = 0.0
    Sound.sounds = o{}


# -- Variants + Modifiers (empty defaults) --------------------------------------

# An empty variant is the common case for vanilla objects; production data
# would carry texture patches per civilisation.
EmptyVariant(engine.util.variant.Variant):
    Variant.changes = o{}
    Variant.priority = 0

# An empty modifier set (no stat changes); satisfies GameEntity.modifiers.
EmptyModifier(engine.modifier.Modifier):
    Modifier.properties = {}


# -- Terrain definition ---------------------------------------------------------

# Single grass-flavoured terrain used by every chunk in the tutorial map.
# path_costs provides 1.0 cost on TutorialGroundPath; default cost for any
# other path_type falls back to the pathfinder default.
TutorialGrass(engine.util.terrain.Terrain):
    Terrain.types = {TutorialTerrainType}
    Terrain.name = GrassName
    Terrain.terrain_graphic = TutorialTerrainGraphic
    Terrain.sound = TutorialSound
    Terrain.ambience = {}
    Terrain.path_costs = {
        TutorialGroundPath : 1
    }

GrassName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        EnglishName
    }


# -- Abilities (Idle, Move, Turn) ----------------------------------------------

# Idle is empty per ability/type.nyan:25 - just need the parent.
TutorialIdle(engine.ability.type.Idle):
    pass

# Move needs speed + modes + path_type per ability/type.nyan:174-178.
TutorialMove(engine.ability.type.Move):
    Move.speed = 3.0
    Move.modes = {TutorialGroundMove}
    Move.path_type = TutorialGroundPath

# Turn needs turn_speed per ability/type.nyan:191.
TutorialTurn(engine.ability.type.Turn):
    Turn.turn_speed = 6.0


# -- GameEntity definitions (villager + town center) ----------------------------

# The tutorial villager: Idle + Move + Turn abilities. Lives in the engine
# modpack namespace because de2_base doesn't exist on disk yet.
TutorialVillager(engine.util.game_entity.GameEntity):
    GameEntity.types = {TutorialUnitType}
    GameEntity.abilities = {
        TutorialIdle,
        TutorialMove,
        TutorialTurn
    }
    GameEntity.modifiers = {}
    GameEntity.variants = {}

# The tutorial town center: same abilities (Idle + Move only, Turn is
# optional for buildings but harmless). The placeholder is shared with the
# villager to keep the data file compact.
TutorialTownCenter(engine.util.game_entity.GameEntity):
    GameEntity.types = {TutorialBuildingType}
    GameEntity.abilities = {
        TutorialIdle
    }
    GameEntity.modifiers = {}
    GameEntity.variants = {}

# Scripted enemy villagers share the villager abilities (we use the same
# underlying TutorialVillager for the GameEntity reference, but the runtime
# owner_id distinguishes friend from foe).
TutorialEnemyVillager(engine.util.game_entity.GameEntity):
    GameEntity.types = {TutorialUnitType}
    GameEntity.abilities = {
        TutorialIdle,
        TutorialMove,
        TutorialTurn
    }
    GameEntity.modifiers = {}
    GameEntity.variants = {}
