!version 0.2.0
# =============================================================================
# HAND-WRITTEN MVP FIXTURE - NOT A CONVERTER PRODUCT.
# Source of truth: assets/test/nyan/tutorial/fixtures/scenario/mission_1.nyan
# Installed to:      assets/converted/engine/util/scenario/mission_1.nyan   (by install.sh)
# Hand-authored stopgap for the Phase 0 tutorial scenario. NOT generated by the
# DE2 converter or `convert-export-api` (api_export). See
# assets/test/nyan/tutorial/README.md for the install/reproducibility flow.
# =============================================================================


import engine.util.game_entity
import engine.util.language
import engine.util.language.translated.type
import engine.util.scenario
import engine.util.setup
import engine.util.terrain
import engine.util.tutorial_data

import engine.root as root

# ---------------------------------------------------------------------------
# Tutorial 1 scenario - minimal map for the campaign tutorial.
#
# All nyan object references here live inside the engine modpack
# (`engine.util.tutorial_data.*` and `engine.util.setup.tutorial_setup.*`)
# so the scenario loads without requiring a de2_base / aoe2_base converted
# modpack on disk. Once the converter emits real de2_base objects, the
# FQONs can be swapped to point at the converted data; the schema
# (Scenario / TerrainChunkLayout / PlacedEntity) stays the same.
#
# Layout (all coordinates are tile coords, top-left = (0,0)):
#
#     0     7 8     15
#   0 +-----+-+-----+
#     | G  G | G  G |
#   7 +-----+-+-----+
#   8 | G V T| E G  |
#     +-----+-+-----+
#  15 +-----+-+-----+
#     | E G  | G  E |
#     +-----+-+-----+
#
#   G = grass tile          V = player villager
#   T = town center         E = scripted enemy villager
#
# Map is 16x16 tiles, divided into 4 chunks of 8x8 each. All tiles are
# TutorialGrass (engine.util.tutorial_data.TutorialGrass).
# ---------------------------------------------------------------------------

# Size helpers used by Scenario.size and chunk offsets/sizes.
_Size16(engine.util.terrain.Size):
    Size.x = 16
    Size.y = 16

_Size8(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 8

_Size0_0(engine.util.terrain.Size):
    Size.x = 0
    Size.y = 0

_Size8_0(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 0

_Size0_8(engine.util.terrain.Size):
    Size.x = 0
    Size.y = 8

_Size8_8(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 8


# Position helpers for PlacedEntity.position.
_Pos8_8(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 8

_Pos8_9(engine.util.terrain.Size):
    Size.x = 8
    Size.y = 9

_Pos1_1(engine.util.terrain.Size):
    Size.x = 1
    Size.y = 1

_Pos1_14(engine.util.terrain.Size):
    Size.x = 1
    Size.y = 14

_Pos14_1(engine.util.terrain.Size):
    Size.x = 14
    Size.y = 1


# ---------------------------------------------------------------------------
# PlacedEntity instances for Mission 1 - just the bare minimum needed to
# teach the "gather wood" mechanic.
#
#   - 1 player villager at (8, 8)
#   - 1 player town center at (8, 9)
#
# No enemies. No other buildings. The player must select the villager,
# issue a Gather command on a tree, and drop wood off at the TC until
# they hit the 50-wood target. Combat + barracks + archer range are
# Missions 3-5; this mission is purely the gather-economy loop.
# ---------------------------------------------------------------------------

PlayerVillager(engine.util.game_entity.PlacedEntity):
    PlacedEntity.entity = de2_base.data.game_entity.generic.villager.villager.Villager
    PlacedEntity.position = _Pos8_8

PlayerTownCenter(engine.util.game_entity.PlacedEntity):
    PlacedEntity.entity = de2_base.data.game_entity.generic.town_center.town_center.TownCenter
    PlacedEntity.position = _Pos8_9


# ---------------------------------------------------------------------------
# Tile lists. Each chunk has 64 grass tiles; we declare them inline because
# nyan has no fill-with-N syntax. FQON points at the engine modpack's
# self-contained TutorialGrass object.
# ---------------------------------------------------------------------------

