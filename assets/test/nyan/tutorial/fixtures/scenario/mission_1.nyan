# ---------------------------------------------------------------------------
# Translated name for the scenario.
# ---------------------------------------------------------------------------

ScenarioNameText(engine.util.language.LanguageTextPair):
    LanguageTextPair.language = ScenarioLang
    LanguageTextPair.string = "Tutorial 1"

ScenarioName(engine.util.language.translated.type.TranslatedString):
    TranslatedString.translations = {
        ScenarioNameText
    }

ScenarioLang(engine.util.language.Language):
    Language.ietf_string = "en_US"


# ---------------------------------------------------------------------------
# The scenario object itself.
# ---------------------------------------------------------------------------

Mission1(engine.util.scenario.Scenario):
    Scenario.name = ScenarioName
    Scenario.size = _Size16
    Scenario.terrain_chunks = o{
        Chunk00Tiles,
        Chunk01Tiles,
        Chunk10Tiles,
        Chunk11Tiles
    }
    Scenario.initial_entities = o{
        PlayerVillager,
        PlayerTownCenter
    }
